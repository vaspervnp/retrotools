<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RetroTools.Secrets</RootNamespace>

    <!-- Το όνομα του εκτελέσιμου, όχι του project: αυτό πληκτρολογεί ο διαχειριστής. -->
    <AssemblyName>retrotools-secrets</AssemblyName>

    <!-- Το εργαλείο πρέπει να τρέχει σε διακομιστή χωρίς εγκατεστημένο .NET, οπότε
         δημοσιεύεται self-contained σε ένα αρχείο. Ο RID δίνεται στη γραμμή εντολών
         (linux-x64, win-x64, …) ώστε να μη δεσμεύεται το project σε ένα λειτουργικό. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Μόνο ο driver, χωρίς EF Core: το εργαλείο θέλει να ανοίξει μια σύνδεση,
       όχι να χαρτογραφήσει οντότητες. Κρατά το self-contained αρχείο μικρό. -->
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

</Project>
