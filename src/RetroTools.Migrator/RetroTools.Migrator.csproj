<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RetroTools.Migrator</RootNamespace>
    <AssemblyName>retrotools-migrate</AssemblyName>

    <!-- Ο λόγος ύπαρξης του εργαλείου: το `dotnet ef` θέλει SDK. Δημοσιεύεται
         self-contained ώστε να εφαρμόζει migrations σε server χωρίς .NET. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Το EF Core χτίζει το μοντέλο με reflection· το trimming θα το έσπαγε. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetroTools.Configuration\RetroTools.Configuration.csproj" />
    <ProjectReference Include="..\RetroTools.Data\RetroTools.Data.csproj" />
  </ItemGroup>

</Project>
